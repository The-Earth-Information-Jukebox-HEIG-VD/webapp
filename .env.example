# Earth Information Jukebox webapp: environment variables
# Vite bakes VITE_* values into the JS bundle at BUILD time (not at run time).
#
# Where each value comes from:
#   npm run dev    → .env.development (committed), overridden by .env.development.local (yours, gitignored)
#   Docker image   → the Dockerfile writes .env from the build arg VITE_API_URL (required)
#                    deployment: set it in deployment/.env (see deployment/.env.example)
#   npm run build  → .env / .env.production(.local); falls back to /api if unset

# Base URL the browser uses to call the sonification API.
#   /api                        same origin, nginx proxies to the backend (Docker / production)
#   http://localhost:8000/api   dev: browser calls a local backend directly (CORS is open)
VITE_API_URL=/api
