# Dev only (`npm run dev`): the browser calls the sonification backend directly
# instead of going through the Vite dev server. The backend allows any origin
# (JUKEBOX_CORS=*). Production builds use VITE_API_URL=/api (nginx proxy).
#
# Default: backend started with `cd sonification && uvicorn backend.app:app --port 8000`
# or docker-compose with BACKEND_PORT unset.
# Different port on your machine? Override in .env.development.local (gitignored).
VITE_API_URL=http://localhost:8000/api
